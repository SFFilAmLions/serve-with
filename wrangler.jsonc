{
  "name": "serve-with",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "env": {
    "production": {
      "name": "serve-with",
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "serve-with-prod-db",
          "database_id": "d3855bcb-bdc3-4bd2-a0a5-b1fc5d7cdca6"
        }
      ],
      "vars": {
        "ENVIRONMENT": "production"
      }
    },
    "staging": {
      "name": "serve-with-staging",
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "serve-with-staging-db",
          "database_id": "97a54923-d1b5-4f55-bc33-0787c63cd1a1"
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "USAGE_CLOUDFLARE_ACCOUNT_ID": "8dcf1bb3ead186caabaff06fcee82a97",
        "USAGE_D1_DATABASE_ID": "97a54923-d1b5-4f55-bc33-0787c63cd1a1",
        "USAGE_WORKER_NAME": "serve-with-staging"
      }
    }
  }
}
